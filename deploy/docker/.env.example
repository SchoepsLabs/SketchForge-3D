# Copy to .env and fill in your own values. .env is gitignored.
#
# SKETCHFORGE_SHARED_PROJECTS_VOLUME: host path Docker mounts at /data/projects.
# Point at your local clone of lumera-sketchforge-parts.
# Use forward slashes even on Windows (D:/foo/bar).
SKETCHFORGE_SHARED_PROJECTS_VOLUME=

# Optional port override (default 3000)
# SKETCHFORGE_PORT=3000
